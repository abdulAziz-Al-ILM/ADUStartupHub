generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  telegramId      BigInt    @unique
  username        String?
  reportCount     Int       @default(0)
  isBanned        Boolean   @default(false)
  
  // Murakkab Limitlar Tizimi
  projectsWeek    Int       @default(0) // Haftasiga max 2 ta
  lastProjectDate DateTime  @default(now())

  problemsDay     Int       @default(0) // Kuniga max 3 ta
  lastProblemDate DateTime  @default(now())

  resumesDay      Int       @default(0) // Kuniga max 4 ta
  lastResumeDate  DateTime  @default(now())

  requestsDay     Int       @default(0) // Kuniga max 3 ta
  lastRequestDate DateTime  @default(now())

  createdAt       DateTime  @default(now())
  
  // Aloqalar
  projects        Project[]
  requests        Request[]
  problems        Problem[]
  resumes         Resume[]
}

// 1. Startap Loyihalar (Jamoa qidirayotganlar)
model Project {
  id              Int       @id @default(autoincrement())
  title           String
  description     String
  category        String    @default("IT & Dasturlash") // Katalog uchun
  status          String    @default("ACTIVE")
  authorId        Int
  author          User      @relation(fields: [authorId], references: [id])
  createdAt       DateTime  @default(now())
  requests        Request[]
}

// 2. Talaba E'lonlari (Jamoaga qo'shilishni istaganlar / Rezyume)
model Resume {
  id              Int       @id @default(autoincrement())
  skills          String    // Nimalarni bilishi
  category        String    @default("Dasturchi") // Katalog uchun
  authorId        Int
  author          User      @relation(fields: [authorId], references: [id])
  createdAt       DateTime  @default(now())
}

// 3. Muammolar (Yechim talab qiladigan dolzarb mavzular)
model Problem {
  id              Int       @id @default(autoincrement())
  description     String
  authorId        Int
  author          User      @relation(fields: [authorId], references: [id])
  createdAt       DateTime  @default(now())
}

// 4. Loyihaga qo'shilish so'rovlari
model Request {
  id              Int       @id @default(autoincrement())
  coverLetter     String
  status          String    @default("PENDING")
  projectId       Int
  project         Project   @relation(fields: [projectId], references: [id])
  applicantId     Int
  applicant       User      @relation(fields: [applicantId], references: [id])
  createdAt       DateTime  @default(now())
}
