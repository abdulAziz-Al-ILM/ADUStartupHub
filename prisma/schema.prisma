generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  telegramId      BigInt    @unique
  username        String?
  reportCount     Int       @default(0)
  isBanned        Boolean   @default(false)
  
  projectsWeek    Int       @default(0) 
  lastProjectDate DateTime  @default(now())
  problemsDay     Int       @default(0) 
  lastProblemDate DateTime  @default(now())
  resumesDay      Int       @default(0) 
  lastResumeDate  DateTime  @default(now())
  requestsDay     Int       @default(0) 
  lastRequestDate DateTime  @default(now())

  createdAt       DateTime  @default(now())
  
  projects        Project[]
  requests        Request[]
  problems        Problem[]
  resumes         Resume[]
}

model Project {
  id              Int       @id @default(autoincrement())
  title           String
  
  // Yangi aqlli shablon maydonlari
  problemCause    String    @default("Ko'rsatilmagan") // Muammo sababi
  goal            String    @default("Ko'rsatilmagan") // Asosiy maqsad
  benefits        String    @default("Ko'rsatilmagan") // Kim qancha manfaat ko'radi
  hiddenSolution  String    @default("Ko'rsatilmagan") // Faqat jamoaga ko'rinuvchi yechim
  
  groupLink       String    @default("Kiritilmagan")
  category        String    @default("IT & Dasturlash") 
  status          String    @default("TEAM_BUILDING") 
  cancelReason    String?   

  authorId        Int
  author          User      @relation(fields: [authorId], references: [id])
  createdAt       DateTime  @default(now())
  
  // Loyihaga kelgan arizalar
  requests        Request[]
}

model Resume {
  id              Int       @id @default(autoincrement())
  skills          String    
  category        String    @default("Dasturchi") 
  authorId        Int
  author          User      @relation(fields: [authorId], references: [id])
  createdAt       DateTime  @default(now())
}

model Problem {
  id              Int       @id @default(autoincrement())
  description     String
  // Anonim bo'lishi uchun muallif ochiq ko'rsatilmaydi, lekin bazada kimligini bilib turamiz (xavfsizlik uchun)
  authorId        Int
  author          User      @relation(fields: [authorId], references: [id])
  createdAt       DateTime  @default(now())
}

model Request {
  id              Int       @id @default(autoincrement())
  coverLetter     String
  status          String    @default("PENDING") // PENDING, ACCEPTED, REJECTED
  
  // "Instagram" 1x qoidasi uchun aloqalar
  projectId       Int
  project         Project   @relation(fields: [projectId], references: [id])
  applicantId     Int
  applicant       User      @relation(fields: [applicantId], references: [id])
  createdAt       DateTime  @default(now())

  // Bitta foydalanuvchi bitta loyihaga faqat 1 ta ariza yubora oladi (Takrorlanishni oldini oladi)
  @@unique([projectId, applicantId])
}
